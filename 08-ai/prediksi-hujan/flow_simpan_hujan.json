[
  {"id": "rh_tab", "type": "tab", "label": "Simpan Data Hujan", "disabled": false, "info": ""},
  {"id": "rh_suhu", "type": "mqtt in", "z": "rh_tab", "name": "rr/suhu", "topic": "rr/suhu", "qos": "0", "datatype": "auto-detect", "broker": "rh_broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 130, "y": 80, "wires": [["rh_ingat"]]},
  {"id": "rh_lembap", "type": "mqtt in", "z": "rh_tab", "name": "rr/kelembapan", "topic": "rr/kelembapan", "qos": "0", "datatype": "auto-detect", "broker": "rh_broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 150, "y": 140, "wires": [["rh_ingat"]]},
  {"id": "rh_hujan", "type": "mqtt in", "z": "rh_tab", "name": "rr/hujan", "topic": "rr/hujan", "qos": "0", "datatype": "auto-detect", "broker": "rh_broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 130, "y": 200, "wires": [["rh_ingat"]]},
  {"id": "rh_ingat", "type": "function", "z": "rh_tab", "name": "ingat nilai terakhir", "func": "// simpan nilai terakhir tiap topik di memori flow\nflow.set(msg.topic, msg.payload);\nreturn null;", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 390, "y": 140, "wires": [[]]},
  {"id": "rh_jam", "type": "inject", "z": "rh_tab", "name": "tiap 1 jam", "props": [{"p": "payload"}], "repeat": "3600", "crontab": "", "once": false, "onceDelay": 0.1, "topic": "", "payload": "", "payloadType": "date", "x": 140, "y": 300, "wires": [["rh_baris"]]},
  {"id": "rh_baris", "type": "function", "z": "rh_tab", "name": "baris: data 1 jam lalu + hujan sekarang", "func": "// label 'hujan_1jam' = apakah SEKARANG hujan,\n// dipasangkan dengan suhu & kelembapan SATU JAM LALU\nconst hujan = String(flow.get('rr/hujan')) === '1' ? 'ya' : 'tidak';\nconst lalu = flow.get('jamLalu');\nflow.set('jamLalu', {\n    suhu: Number(flow.get('rr/suhu')),\n    lembap: Number(flow.get('rr/kelembapan'))\n});\nif (!lalu || isNaN(lalu.suhu) || isNaN(lalu.lembap)) return null;\nmsg.payload = lalu.suhu + ',' + lalu.lembap + ',' + hujan;\nreturn msg;", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 430, "y": 300, "wires": [["rh_file", "rh_dbg"]]},
  {"id": "rh_file", "type": "file", "z": "rh_tab", "name": "hujan.csv", "filename": "/home/rizky/data/hujan.csv", "filenameType": "str", "appendNewline": true, "createDir": true, "overwriteFile": "false", "encoding": "none", "x": 720, "y": 280, "wires": [[]]},
  {"id": "rh_dbg", "type": "debug", "z": "rh_tab", "name": "cek", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "payload", "targetType": "msg", "x": 710, "y": 340, "wires": []},
  {"id": "rh_broker", "type": "mqtt-broker", "name": "Mosquitto", "broker": "localhost", "port": "1883", "clientid": "", "autoConnect": true, "usetls": false, "protocolVersion": "4", "keepalive": "60", "cleansession": true}
]
