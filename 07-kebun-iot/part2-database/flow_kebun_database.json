[
  {"id": "kb_tab", "type": "tab", "label": "Kebun: Simpan ke Database", "disabled": false, "info": ""},
  {"id": "kb_buat", "type": "inject", "z": "kb_tab", "name": "buat tabel (klik 1x)", "props": [{"p": "topic", "vt": "str"}], "repeat": "", "crontab": "", "once": true, "onceDelay": 1, "topic": "CREATE TABLE IF NOT EXISTS kebun (waktu TEXT, tanah REAL, suhu REAL, kelembapan REAL)", "x": 160, "y": 60, "wires": [["kb_sql_topic"]]},
  {"id": "kb_sql_topic", "type": "sqlite", "z": "kb_tab", "mydb": "kb_db", "sqlquery": "msg.topic", "sql": "", "name": "kebun.db (perintah)", "x": 430, "y": 60, "wires": [["kb_dbg"]]},
  {"id": "kb_tanah", "type": "mqtt in", "z": "kb_tab", "name": "kebun/tanah", "topic": "kebun/tanah", "qos": "0", "datatype": "auto-detect", "broker": "kb_broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 130, "y": 160, "wires": [["kb_fn"]]},
  {"id": "kb_suhu", "type": "mqtt in", "z": "kb_tab", "name": "kebun/suhu", "topic": "kebun/suhu", "qos": "0", "datatype": "auto-detect", "broker": "kb_broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 130, "y": 220, "wires": [["kb_fn"]]},
  {"id": "kb_lembap", "type": "mqtt in", "z": "kb_tab", "name": "kebun/kelembapan", "topic": "kebun/kelembapan", "qos": "0", "datatype": "auto-detect", "broker": "kb_broker", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 150, "y": 280, "wires": [["kb_fn"]]},
  {"id": "kb_fn", "type": "function", "z": "kb_tab", "name": "susun INSERT", "func": "// simpan nilai terakhir tiap topik\nflow.set(msg.topic, Number(msg.payload));\nif (msg.topic !== \"kebun/kelembapan\") return null;\n\n// data lengkap: isi parameter INSERT\nmsg.params = {\n    $tanah: flow.get(\"kebun/tanah\"),\n    $suhu: flow.get(\"kebun/suhu\"),\n    $lembap: flow.get(\"kebun/kelembapan\")\n};\nreturn msg;", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 390, "y": 220, "wires": [["kb_rate"]]},
  {"id": "kb_rate", "type": "delay", "z": "kb_tab", "name": "1 data per menit", "pauseType": "rate", "timeout": "5", "timeoutUnits": "seconds", "rate": "1", "nbRateUnits": "1", "rateUnits": "minute", "randomFirst": "1", "randomLast": "5", "randomUnits": "seconds", "drop": true, "allowrate": false, "outputs": 1, "x": 590, "y": 220, "wires": [["kb_sql_ins"]]},
  {"id": "kb_sql_ins", "type": "sqlite", "z": "kb_tab", "mydb": "kb_db", "sqlquery": "prepared", "sql": "INSERT INTO kebun (waktu, tanah, suhu, kelembapan)\nVALUES (datetime('now','localtime'), $tanah, $suhu, $lembap);", "name": "simpan ke kebun.db", "x": 810, "y": 220, "wires": [[]]},
  {"id": "kb_lihat", "type": "inject", "z": "kb_tab", "name": "lihat 24 jam terakhir", "props": [{"p": "topic", "vt": "str"}], "repeat": "", "crontab": "", "once": false, "onceDelay": 0.1, "topic": "SELECT * FROM kebun WHERE waktu >= datetime('now','localtime','-24 hours') ORDER BY waktu", "x": 170, "y": 380, "wires": [["kb_sql_sel"]]},
  {"id": "kb_sql_sel", "type": "sqlite", "z": "kb_tab", "mydb": "kb_db", "sqlquery": "msg.topic", "sql": "", "name": "kebun.db (riwayat)", "x": 430, "y": 380, "wires": [["kb_chart_fn", "kb_dbg"]]},
  {"id": "kb_chart_fn", "type": "function", "z": "kb_tab", "name": "siapkan untuk chart", "func": "// tiap baris jadi satu titik: x = waktu, y = kelembapan tanah\nmsg.payload = msg.payload.map(r => ({ x: r.waktu, y: r.tanah }));\nreturn msg;", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 680, "y": 360, "wires": [[]]},
  {"id": "kb_dbg", "type": "debug", "z": "kb_tab", "name": "cek", "active": true, "tosidebar": true, "console": false, "tostatus": false, "complete": "payload", "targetType": "msg", "x": 670, "y": 420, "wires": []},
  {"id": "kb_db", "type": "sqlitedb", "db": "/home/rizky/data/kebun.db", "mode": "RWC"},
  {"id": "kb_broker", "type": "mqtt-broker", "name": "Mosquitto", "broker": "localhost", "port": "1883", "clientid": "", "autoConnect": true, "usetls": false, "protocolVersion": "4", "keepalive": "60", "cleansession": true}
]
